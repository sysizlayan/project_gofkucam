<?xml version="1.0" encoding="UTF-8"?>
<model version="7.0.2" links="0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.state-machine.com/qm/qm7.xsd">
 <framework name="qpcpp"/>
 <package name="Evts" stereotype="0x01" namespace="GofkuCam::">
  <attribute name="EvtSignals" type="enum" visibility="0x04" properties="0x00">
   <code>: QP::QSignal
{
    FRAME_TIMER_TIMEOUT_SIG  = QP::Q_USER_SIG,
    POLLING_TIMER_TIMEOUT_SIG,
    FRAME_CAPTURED_SIG,
    STREAM_ENDED_SIG,
    CAPTURE_ERROR_SIG,
    START_REQ_SIG,
    STOP_REQ_SIG,

    MAX_GOFKU_CAM_SIG
};</code>
  </attribute>
  <class name="FrameCapturedEvt" superclass="qpcpp::QEvt">
   <attribute name="m_frame" type="std::shared_ptr&lt;Frame&gt;" visibility="0x00" properties="0x00"/>
   <operation name="FrameCapturedEvt" type="" visibility="0x00" properties="0x02">
    <code>: QEvt(EvtSignals::FRAME_CAPTURED_SIG)
, m_frame{nullptr}</code>
   </operation>
  </class>
  <class name="FrameTimerTimeout" superclass="qpcpp::QEvt">
   <operation name="FrameTimerTimeout" type="" visibility="0x00" properties="0x02">
    <code>: QEvt(EvtSignals::FRAME_TIMER_TIMEOUT_SIG)</code>
   </operation>
  </class>
  <class name="StreamEnded" superclass="qpcpp::QEvt">
   <operation name="StreamEnded" type="" visibility="0x00" properties="0x00">
    <code>: QEvt(EvtSignals::STREAM_ENDED_SIG)</code>
   </operation>
  </class>
  <class name="CaptureError" superclass="qpcpp::QEvt">
   <operation name="CaptureError" type="" visibility="0x00" properties="0x00">
    <code>: QEvt(EvtSignals::CAPTURE_ERROR_SIG)</code>
   </operation>
  </class>
  <class name="StopRequested" superclass="qpcpp::QEvt">
   <operation name="StopRequested" type="" visibility="0x00" properties="0x00">
    <code>: QEvt(EvtSignals::STOP_REQ_SIG)</code>
   </operation>
  </class>
  <class name="StartRequested" superclass="qpcpp::QEvt">
   <operation name="StartRequested" type="" visibility="0x00" properties="0x00">
    <code>: QEvt(EvtSignals::START_REQ_SIG)</code>
   </operation>
  </class>
  <class name="PollingTimerTimeout" superclass="qpcpp::QEvt">
   <operation name="PollingTimerTimeout" type="" visibility="0x00" properties="0x00">
    <code>: QEvt(EvtSignals::POLLING_TIMER_TIMEOUT_SIG)</code>
   </operation>
  </class>
 </package>
 <package name="Components" stereotype="0x02">
  <class name="CameraGrabber" superclass="qpcpp::QActive">
   <attribute name="m_logger" type="LoggerInterfacePtr" visibility="0x02" properties="0x00"/>
   <attribute name="m_icamera_grabber" type="std::shared_ptr&lt;ICameraGrabber&gt;" visibility="0x00" properties="0x00"/>
   <operation name="CameraGrabber" type="" visibility="0x00" properties="0x00">
    <parameter name="logger" type="LoggerInterfacePtr"/>
    <parameter name="source" type="std::string"/>
    <code>: QActive(&amp;initial)
, m_logger(logger)
, m_icamera_grabber{std::make_shared&lt;CameraGrabberImpl&gt;(this, m_logger)}

m_logger-&gt;trace(&quot;The Controller ctor!&quot;);</code>
   </operation>
   <statechart properties="0x00">
    <initial target="../1">
     <action>(void)e; // Just to supress compiler warning
(void)Q_this_module_; // Just to supress compiler warning</action>
     <initial_glyph conn="9,4,5,1,67,7,-4">
      <action box="1,-3,10,2"/>
     </initial_glyph>
    </initial>
    <state name="NOT_STARTED">
     <tran trig="START_REQ">
      <action>m_icamera_grabber-&gt;start_req();
</action>
      <choice target="../../../2">
       <guard>m_icamera_grabber-&gt;is_opened()</guard>
       <choice_glyph conn="30,18,5,1,44,15,-2">
        <action box="1,0,30,5"/>
       </choice_glyph>
      </choice>
      <tran_glyph conn="6,18,3,-1,24">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="6,7,66,16"/>
    </state>
    <state name="RUNNING">
     <entry>m_icamera_grabber-&gt;running_entry();
</entry>
     <tran trig="STREAM_ENDED, CAPTURE_ERROR" target="../../1">
      <action>m_icamera_grabber-&gt;stream_end();
</action>
      <tran_glyph conn="5,42,3,1,74,-26,-7">
       <action box="0,-2,47,2"/>
      </tran_glyph>
     </tran>
     <tran trig="FRAME_TIMER_TIMEOUT">
      <action>m_icamera_grabber-&gt;frame_timer_timeout();
</action>
      <tran_glyph conn="5,32,3,-1,29">
       <action box="0,-2,20,2"/>
      </tran_glyph>
     </tran>
     <tran trig="STOP_REQ">
      <action>m_icamera_grabber-&gt;stop_req();
</action>
      <tran_glyph conn="5,38,3,-1,29">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <tran trig="POLLING_TIMER_TIMEOUT">
      <action>m_icamera_grabber-&gt;poll_the_camera();
</action>
      <tran_glyph conn="5,35,3,-1,29">
       <action box="0,-2,28,3"/>
      </tran_glyph>
     </tran>
     <state_glyph node="5,27,67,20">
      <entry box="0,3,6,2"/>
     </state_glyph>
    </state>
    <state_diagram size="125,142"/>
   </statechart>
  </class>
  <class name="DetectorController" superclass="qpcpp::QActive">
   <attribute name="m_logger" type="LoggerInterfacePtr" visibility="0x02" properties="0x00"/>
   <attribute name="m_detector" type="std::shared_ptr&lt;ObjectDetector&gt;" visibility="0x00" properties="0x00"/>
   <operation name="DetectorController" type="" visibility="0x00" properties="0x00">
    <parameter name="logger" type="LoggerInterfacePtr"/>
    <parameter name="detector" type="std::shared_ptr&lt;ObjectDetector&gt;"/>
    <code>: QActive(&amp;initial)
, m_logger(logger)

m_logger-&gt;trace(&quot;Camera grabber started!&quot;);</code>
   </operation>
   <statechart properties="0x00">
    <initial target="../1">
     <action>(void)e; // Just to supress compiler warning
(void)Q_this_module_; // Just to supress compiler warning
</action>
     <initial_glyph conn="9,4,5,1,97,11,-2">
      <action box="1,-3,10,2"/>
     </initial_glyph>
    </initial>
    <state name="operating">
     <tran trig="FRAME_CAPTURED">
      <action>/*
m_frame_strategy-&gt;unsubscribeFromFrameUpdates(this);
Frame frame;
m_frame_strategy-&gt;grabFrame(frame);
// Detect objects in the frame
#ifdef MINI_PROFILER
// Mini profiler
//static int call_count = 0;
std::chrono::steady_clock::time_point begin = std::chrono::steady_clock::now();
#endif

std::vector&lt;Detection&gt; results = m_detector-&gt;detect(frame);
//m_detector-&gt;draw_bounding_box_mask(frame, results);

#ifdef MINI_PROFILER
std::chrono::steady_clock::time_point end = std::chrono::steady_clock::now();
m_logger-&gt;info(&quot;Detection took &quot; + std::to_string(std::chrono::duration_cast&lt;std::chrono::milliseconds&gt;(end - begin).count()) + &quot;[ms]&quot;);
#endif
m_frame_strategy-&gt;subscribeToFrameUpdates(this);

std::stringstream ss;
ss&lt;&lt;&quot;Frame processed: &quot; &lt;&lt; frame.size;
m_logger-&gt;info(ss.str());
*/
m_logger-&gt;info(&quot;New frame&quot;);
std::shared_ptr&lt;Frame&gt; frame = Q_EVT_CAST(FrameCapturedEvt)-&gt;m_frame;
m_logger-&gt;trace(&quot;Captured frame with size: &quot; + std::to_string(frame-&gt;cols) + &quot;x&quot; + std::to_string(frame-&gt;rows));

// Display the frame
cv::imshow(&quot;GofkuCam Stream&quot;, *frame);
cv::waitKey(1); // Allow the window to update, wait 1ms
//cv::destroyAllWindows();</action>
      <tran_glyph conn="6,12,3,-1,14,1">
       <action box="0,-2,10,2"/>
      </tran_glyph>
     </tran>
     <state_glyph node="6,8,98,21"/>
    </state>
    <state_diagram size="125,142"/>
   </statechart>
  </class>
 </package>
