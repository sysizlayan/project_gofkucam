{
using Frame = cv::Mat;
using FramePtr = std::shared_ptr&lt;Frame&gt;;
using ActiveObjPtr = QP::QActive*;

}

#endif</text>
  </file>
  <file name="Evts.hpp">
   <text>#ifndef EVTS_HPP_
#define EVTS_HPP_

#include &quot;qpcpp.hpp&quot;
#include &lt;variant&gt;
#include &quot;Signals.hpp&quot;

$declare ${Evts}

namespace GofkuCam
{
    using EventTyp     = std::variant&lt;FrameCapturedEvt, TimerTimedOut, FrameGrabbingFailed&gt;;
} // namespace GofkuCam

#endif</text>
  </file>
 </directory>
</model>
