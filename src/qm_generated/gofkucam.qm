    CAPTURE_ERROR_SIG,
    START_REQ_SIG,
    STOP_REQ_SIG,
    DEPTH_ESTIMATION_FAILED_SIG,

    MAX_GOFKU_CAM_SIG
};</code>
  </attribute>
  <class name="FrameCapturedEvt" superclass="qpcpp::QEvt">
   <attribute name="m_frame" type="std::shared_ptr&lt;Frame&gt;" visibility="0x00" properties="0x00"/>
   <operation name="FrameCapturedEvt" type="" visibility="0x00" properties="0x02">
