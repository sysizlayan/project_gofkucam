#endif</text>
  </file>
  <file name="Signals.hpp">
   <text>#ifndef GOFKUCAMSIGNALS_HPP_
#define GOFKUCAMSIGNALS_HPP_

#include &quot;qpcpp.hpp&quot;
#include &lt;opencv2/opencv.hpp&gt;

